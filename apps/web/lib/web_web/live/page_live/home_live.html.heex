<%!-- home.html.heex — LiveView version of the home page --%>
<div class="min-h-screen bg-slate-50 font-sans">
  <header class="bg-white px-8 py-4 shadow-sm flex justify-between items-center border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="bg-amber-100 p-2 rounded-lg text-amber-500">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
          />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-slate-800 leading-none">Procesador de Archivos</h1>
        <p class="text-sm text-slate-500">Sistema de procesamiento inteligente</p>
      </div>
    </div>
    <nav class="flex gap-4">
      <button class="bg-indigo-600 text-white px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2 text-nowrap">
        <span class="bg-indigo-400 w-5 h-5 rounded-full flex items-center justify-center text-[10px]">
          1
        </span>
        Configuración
      </button>
      <button class="bg-slate-100 text-slate-400 px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2 cursor-not-allowed text-nowrap">
        <span class="bg-slate-300 w-5 h-5 rounded-full flex items-center justify-center text-[10px] text-white">
          2
        </span>
        Resultados
      </button>
    </nav>
  </header>

  <main class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 p-8 items-start">
    <div class="flex-1 w-full space-y-8">
      <section class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100">
        <h2 class="text-2xl font-bold text-slate-800 mb-1">Configuración de Procesamiento</h2>
        <p class="text-slate-500 mb-8">Configure las opciones para procesar sus archivos</p>

        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <div class="flex items-center gap-2 mb-4 text-amber-500 font-semibold">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            Selección de Archivos
          </div>

          <%!-- LiveView Upload Form --%>
          <form
            id="upload-form"
            phx-submit={
              if @processing_mode == "benchmark", do: "process_benchmark", else: "process_files"
            }
            phx-change="validate"
          >
            <%!-- Drag & Drop Upload Zone --%>
            <label
              class="group relative flex flex-col items-center justify-center w-full h-64 border-2 border-dashed border-indigo-200 bg-white rounded-2xl cursor-pointer hover:border-indigo-400 hover:bg-indigo-50/50 transition-all duration-300"
              phx-drop-target={@uploads.archivos.ref}
            >
              <div class="flex flex-col items-center justify-center pt-5 pb-6">
                <div class="p-4 bg-indigo-50 rounded-full group-hover:scale-110 transition-transform duration-300 mb-4">
                  <svg
                    class="w-10 h-10 text-indigo-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                    >
                    </path>
                  </svg>
                </div>
                <p class="mb-2 text-sm text-slate-700 font-semibold">
                  <span class="text-indigo-600 underline">Haz clic para cargar</span>
                  o arrastra y suelta
                </p>
                <p class="text-xs text-slate-400 uppercase tracking-widest font-bold">
                  CSV • XML • JSON • LOG
                </p>
              </div>
              <.live_file_input upload={@uploads.archivos} class="hidden" />
            </label>

            <%!-- Upload errors --%>
            <%= for entry <- @uploads.archivos.entries do %>
              <%= for err <- upload_errors(@uploads.archivos, entry) do %>
                <p class="mt-2 text-xs text-rose-500">
                  {entry.client_name}: {upload_error_message(err)}
                </p>
              <% end %>
            <% end %>

            <%!-- Processing Mode Selection --%>
            <div class="mt-6">
              <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4">
                Modo de Procesamiento
              </h3>

              <div class="flex flex-col gap-3">
                <%!-- Sequential Mode --%>
                <label class={"flex items-center justify-between p-4 bg-white border rounded-2xl cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30 transition-all group #{if @processing_mode == "sequential", do: "border-indigo-400 bg-indigo-50/30", else: "border-slate-200"}"}>
                  <div class="flex items-center gap-3">
                    <div class="p-2 bg-slate-100 rounded-lg text-slate-500 group-hover:bg-slate-200">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5l7 7-7 7"
                        />
                      </svg>
                    </div>
                    <div>
                      <span class="block text-sm font-bold text-slate-800">Modo Secuencial</span>
                      <span class="block text-[11px] text-slate-400">
                        Procesa un archivo a la vez
                      </span>
                    </div>
                  </div>
                  <div class="relative flex items-center">
                    <input
                      type="radio"
                      name="processing_mode"
                      value="sequential"
                      checked={@processing_mode == "sequential"}
                      phx-click="set_mode"
                      phx-value-mode="sequential"
                      class="peer h-6 w-6 appearance-none rounded-full border-2 border-slate-300 checked:bg-indigo-600 checked:border-indigo-600 transition-all"
                    />
                    <div class="absolute left-1.5 w-3 h-3 bg-white rounded-full opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity">
                    </div>
                  </div>
                </label>

                <%!-- Parallel Mode --%>
                <label class={"flex items-center justify-between p-4 bg-white border rounded-2xl cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30 transition-all group #{if @processing_mode == "parallel", do: "border-indigo-400 bg-indigo-50/30", else: "border-slate-200"}"}>
                  <div class="flex items-center gap-3">
                    <div class="p-2 bg-blue-50 rounded-lg text-blue-500 group-hover:bg-blue-100">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 6h16M4 12h16M4 18h16"
                        />
                      </svg>
                    </div>
                    <div>
                      <span class="block text-sm font-bold text-slate-800">Modo Paralelo</span>
                      <span class="block text-[11px] text-slate-400">
                        Múltiples archivos simultáneos
                      </span>
                    </div>
                  </div>
                  <div class="relative flex items-center">
                    <input
                      type="radio"
                      name="processing_mode"
                      value="parallel"
                      checked={@processing_mode == "parallel"}
                      phx-click="set_mode"
                      phx-value-mode="parallel"
                      class="peer h-6 w-6 appearance-none rounded-full border-2 border-slate-300 checked:bg-indigo-600 checked:border-indigo-600 transition-all"
                    />
                    <div class="absolute left-1.5 w-3 h-3 bg-white rounded-full opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity">
                    </div>
                  </div>
                </label>

                <%!-- Benchmark Mode --%>
                <label class={"flex items-center justify-between p-4 bg-white border rounded-2xl cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30 transition-all group #{if @processing_mode == "benchmark", do: "border-indigo-400 bg-indigo-50/30", else: "border-slate-200"}"}>
                  <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-50 rounded-lg text-amber-500 group-hover:bg-amber-100">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 10V3L4 14h7v7l9-11h-7z"
                        />
                      </svg>
                    </div>
                    <div>
                      <span class="block text-sm font-bold text-slate-800">Modo Benchmark</span>
                      <span class="block text-[11px] text-slate-400">
                        Métricas de rendimiento
                      </span>
                    </div>
                  </div>
                  <div class="relative flex items-center">
                    <input
                      type="radio"
                      name="processing_mode"
                      value="benchmark"
                      checked={@processing_mode == "benchmark"}
                      phx-click="set_mode"
                      phx-value-mode="benchmark"
                      class="peer h-6 w-6 appearance-none rounded-full border-2 border-slate-300 checked:bg-indigo-600 checked:border-indigo-600 transition-all"
                    />
                    <div class="absolute left-1.5 w-3 h-3 bg-white rounded-full opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity">
                    </div>
                  </div>
                </label>
              </div>
            </div>

            <%!-- Advanced Settings Toggle (Parallel Mode Only) --%>
            <%= if @processing_mode == "parallel" do %>
              <div class="mt-6">
                <label class="flex items-center gap-2 text-sm text-slate-600 cursor-pointer hover:text-slate-800 transition-colors group">
                  <input
                    type="checkbox"
                    checked={@show_advanced}
                    phx-click="toggle_advanced"
                    class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500 cursor-pointer"
                  />
                  <span class="font-medium">Mostrar Configuración Avanzada</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-slate-400 group-hover:text-blue-500 transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                </label>
                <p class="text-[11px] text-slate-400 mt-2 ml-6">
                  Valores por defecto: 8 workers, 30s timeout
                </p>
              </div>
            <% end %>

            <%!-- Advanced Configuration Panel --%>
            <%= if @processing_mode == "parallel" && @show_advanced do %>
              <div class="mt-4">
                <div class="border-t border-slate-200 pt-6">
                  <div class="flex items-center gap-2 mb-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-blue-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                      />
                    </svg>
                    <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider">
                      Advanced Settings
                    </h3>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <%!-- Max Workers --%>
                    <div class="bg-white p-4 rounded-xl border border-slate-200">
                      <label
                        for="max-workers"
                        class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2"
                      >
                        Max Workers
                      </label>
                      <input
                        type="number"
                        name="max_workers"
                        id="max-workers"
                        min="1"
                        max={System.schedulers_online() * 2}
                        value="8"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                      />
                      <p class="mt-2 text-[10px] text-slate-400 leading-relaxed">
                        Número de workers concurrentes (1-{System.schedulers_online() * 2}).
                        Recomendado: {System.schedulers_online()}-{System.schedulers_online() * 2} para tu sistema.
                      </p>
                    </div>

                    <%!-- Timeout --%>
                    <div class="bg-white p-4 rounded-xl border border-slate-200">
                      <label
                        for="timeout"
                        class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2"
                      >
                        Timeout (ms)
                      </label>
                      <input
                        type="number"
                        name="timeout"
                        id="timeout"
                        min="1000"
                        max="60000"
                        step="1000"
                        value="30000"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                      />
                      <p class="mt-2 text-[10px] text-slate-400 leading-relaxed">
                        Tiempo máx. por archivo en ms (1,000-60,000). Por defecto: 30,000ms.
                      </p>
                    </div>
                  </div>

                  <%!-- Performance Warning --%>
                  <div class="mt-4 flex gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-amber-500 flex-shrink-0 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      />
                    </svg>
                    <div>
                      <p class="text-xs font-semibold text-amber-700">Nota de Rendimiento</p>
                      <p class="text-[11px] text-amber-600 mt-1">
                        Demasiados workers pueden saturar tu CPU. Empieza con los valores por defecto.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </form>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100">
        <div class="flex justify-end">
          <% submit_disabled =
            @processing or
              Enum.any?(@uploads.archivos.entries, &(upload_errors(@uploads.archivos, &1) != [])) or
              @uploads.archivos.errors != [] %>

          <%!-- Barra de progreso — visible solo mientras procesa --%>
          <%= if @processing do %>
            <div class="w-full mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-semibold text-indigo-700">Analizando archivos...</span>
                <span class="text-xs text-indigo-400 animate-pulse">Por favor espera</span>
              </div>
              <div class="w-full h-2.5 bg-indigo-100 rounded-full overflow-hidden">
                <div
                  class="h-full bg-indigo-500 rounded-full animate-[progress_1.8s_ease-in-out_infinite]"
                  style="width: 100%; animation: indeterminate 1.8s ease-in-out infinite; transform-origin: left;"
                >
                </div>
              </div>
              <style>
                @keyframes indeterminate {
                  0%   { transform: translateX(-100%) scaleX(0.4); }
                  50%  { transform: translateX(0%)    scaleX(0.6); }
                  100% { transform: translateX(100%)  scaleX(0.4); }
                }
              </style>
            </div>
          <% end %>

          <div class="flex flex-col items-end gap-2 w-full">
            <button
              type="submit"
              form="upload-form"
              disabled={submit_disabled}
              class="bg-indigo-600 hover:bg-indigo-700 disabled:opacity-60 disabled:cursor-not-allowed text-white px-8 py-3 rounded-2xl font-bold transition-all shadow-xl shadow-indigo-100 flex items-center gap-2 group"
            >
              <%= if @processing do %>
                <svg
                  class="animate-spin h-5 w-5"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  >
                  </circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                  >
                  </path>
                </svg>
                Procesando...
              <% else %>
                Comenzar Procesamiento
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              <% end %>
            </button>

            <%!-- Mensaje inline cuando no hay archivos seleccionados --%>
            <%= if @no_files_error and @uploads.archivos.entries == [] do %>
              <div class="flex items-center gap-1.5 text-rose-500 animate-pulse">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
                <span class="text-xs font-semibold">
                  Selecciona al menos un archivo antes de continuar
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    </div>

    <%!-- Right Aside: Live Preview + Errors --%>
    <aside class="w-full lg:w-[400px] flex-shrink-0 sticky top-8 space-y-4">
      <%!-- Recopilamos todos los errores reactivamente --%>
      <% entry_errors =
        for entry <- @uploads.archivos.entries,
            err <- upload_errors(@uploads.archivos, entry),
            do: {entry.client_name, err}

      global_errors = @uploads.archivos.errors
      has_errors = entry_errors != [] or global_errors != [] %>

      <%!-- Panel de errores — aparece automáticamente al detectar problemas --%>
      <%= if has_errors do %>
        <section class="bg-rose-50 rounded-3xl p-6 border border-rose-200 shadow-sm">
          <div class="flex items-center gap-2 mb-4">
            <div class="p-1.5 bg-rose-100 rounded-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-rose-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
            </div>
            <h3 class="font-bold text-rose-700 text-sm">Problemas detectados</h3>
            <span class="ml-auto bg-rose-100 text-rose-600 text-[10px] px-2 py-0.5 rounded-full font-bold">
              {length(entry_errors) + length(global_errors)}
            </span>
          </div>

          <div class="space-y-2">
            <%!-- Errores por archivo: formato no soportado, archivo muy grande --%>
            <%= for {filename, err} <- entry_errors do %>
              <div class="flex items-start gap-2 bg-white rounded-xl px-3 py-2.5 border border-rose-100">
                <span class="text-rose-400 mt-0.5 text-xs font-bold">✕</span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-bold text-slate-700 truncate">{filename}</p>
                  <p class="text-[11px] text-rose-600 mt-0.5">{upload_error_message(err)}</p>
                </div>
              </div>
            <% end %>

            <%!-- Errores globales: demasiados archivos --%>
            <%= for err <- global_errors do %>
              <div class="flex items-start gap-2 bg-white rounded-xl px-3 py-2.5 border border-rose-100">
                <span class="text-rose-400 mt-0.5 text-xs font-bold">✕</span>
                <p class="text-[11px] text-rose-600">{upload_error_message(err)}</p>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%!-- Panel de Vista Previa --%>
      <section class={"bg-white rounded-3xl p-8 shadow-sm border #{if has_errors, do: "border-rose-100", else: "border-slate-100"}"}>
        <h2 class="text-2xl font-bold text-slate-800 mb-1">Vista Previa</h2>
        <p class="text-slate-500 mb-8">Resumen de la carga actual</p>

        <%!-- Estadísticas --%>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-center">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Archivos</p>
            <p class="text-2xl font-bold text-slate-800">{length(@uploads.archivos.entries)}</p>
          </div>
          <div class={"p-4 rounded-xl border text-center #{if has_errors, do: "bg-rose-50 border-rose-100", else: "bg-indigo-50 border-indigo-100"}"}>
            <p class={"text-[10px] font-bold uppercase tracking-wider #{if has_errors, do: "text-rose-400", else: "text-indigo-400"}"}>
              Peso Total
            </p>
            <p class={"text-2xl font-bold #{if has_errors, do: "text-rose-600", else: "text-indigo-600"}"}>
              {Float.round(
                Enum.reduce(@uploads.archivos.entries, 0, fn e, acc -> acc + e.client_size end) /
                  (1024 * 1024),
                2
              )} MB
            </p>
          </div>
        </div>

        <%!-- Lista de archivos con indicador de error por archivo --%>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-2">
            <h3 class="font-bold text-sm text-slate-800 uppercase tracking-tighter">
              Archivos Seleccionados
            </h3>
            <span class={"text-[10px] px-2 py-0.5 rounded-full font-bold #{if has_errors, do: "bg-rose-100 text-rose-600", else: "bg-indigo-100 text-indigo-600"}"}>
              {length(@uploads.archivos.entries)}
            </span>
          </div>

          <div class="space-y-2 max-h-64 overflow-y-auto pr-2">
            <%= if @uploads.archivos.entries == [] do %>
              <div class="flex flex-col items-center py-8 justify-center text-slate-300">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 mb-2 opacity-40"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
                <p class="text-xs italic text-center">Ningún archivo seleccionado aún</p>
              </div>
            <% else %>
              <%= for entry <- @uploads.archivos.entries do %>
                <% file_has_error = upload_errors(@uploads.archivos, entry) != [] %>
                <div class={"flex items-center justify-between gap-2 text-sm py-2 px-3 rounded-lg border shadow-sm #{if file_has_error, do: "bg-rose-50 border-rose-200 text-rose-700", else: "bg-slate-50 border-white text-slate-600"}"}>
                  <div class="flex items-center gap-2 overflow-hidden">
                    <span class="text-lg">{if file_has_error, do: "⚠️", else: "📄"}</span>
                    <span class="truncate font-medium">{entry.client_name}</span>
                  </div>
                  <div class="flex items-center gap-2 flex-shrink-0">
                    <span class={"text-[10px] font-mono px-2 py-0.5 rounded border #{if file_has_error, do: "bg-rose-100 border-rose-200 text-rose-500", else: "bg-white border-slate-200 text-slate-400"}"}>
                      {Float.round(entry.client_size / 1024, 1)} KB
                    </span>
                    <button
                      type="button"
                      phx-click="cancel_upload"
                      phx-value-ref={entry.ref}
                      class="text-slate-300 hover:text-rose-500 transition-colors rounded-full hover:bg-rose-50 p-0.5"
                      title="Eliminar archivo"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M6 18L18 6M6 6l12 12"
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    </aside>
  </main>

  <%!-- Hook JS: reproduce sonido cuando el procesamiento termina --%>
  <div id="sound-hook" phx-hook="ProcessingComplete" class="hidden" aria-hidden="true"></div>
</div>
